# ============ 生产环境：大模型接入（OpenAI 兼容协议，任选服务商） ============
# 例：https://api.deepseek.com/v1  |  https://dashscope.aliyuncs.com/compatible-mode/v1
#     https://api.openai.com/v1    |  https://api.moonshot.cn/v1  |  自建 vLLM: http://127.0.0.1:8000/v1
LLM_BASE_URL=
LLM_API_KEY=
# 留空则启动后在网页「设置」里一键拉取模型列表并自主选择
LLM_MODEL=

# ============ 运行模式 ============
# live  = 调用真实大模型（需要上面三项）
# agent = 测试环境，由智能体（Qoder agent）扮演大模型，内容寻址回放缓存
EXAMGEN_MODE=agent

EXAMGEN_PORT=8787
